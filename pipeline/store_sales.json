						"value": "@and(\n    and(\n        greater(activity('Get Metadata1').output.size, 0),\n        activity('Get Metadata1').output.exists\n    ),\n    and(\n        equals(activity('Lookup1').output.firstRow.allow_load, 'yes'),\n        equals(length(activity('Filter1').output.value), 0)\n    )\n)",
